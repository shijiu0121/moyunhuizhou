# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 环境变量与密钥
.env
*.key

# 前端
node_modules/
dist/
.vite/

# 数据（大文件不入库）
backend/app/data/vector_store/
backend/app/data/models/
backend/app/data/*.jsonl
backend/app/data/*.txt

# 模型与图片产物
*.safetensors
*.ckpt
*.onnx
*.png
*.jpg
*.jpeg
!assets/**/*.png

# 日志
*.log

# IDE
.idea/
.vscode/
.DS_Store

# 随源码分发的知识文本与页面素材。模型、索引和生成产物仍保持忽略。
!backend/app/data/*.txt
!frontend/src/assets/**/*.png
!frontend/src/assets/**/*.jpg
!frontend/src/assets/**/*.jpeg

# 真实配置及切换模式时产生的临时文件
.env.*
!.env.example
