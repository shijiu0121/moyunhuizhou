# 复制本文件为 .env 并填入真实值（.env 不要提交到 git）

# DeepSeek API（OpenAI 兼容）
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 图像生成模式：local | remote | api
#   local  -> 本机/同一进程有 GPU，直接用本地 SDXL+LoRA
#   remote -> GPU 在远程机器，通过 HTTP 调用远程生图服务
#   api    -> 云生图 API（备胎，需填 CLOUD_IMAGE_API）
IMAGE_GEN_MODE=api

# 远程生图服务地址（IMAGE_GEN_MODE=remote 时使用）
REMOTE_IMAGE_SERVICE_URL=http://192.168.x.x:9000

# 云生图 API（IMAGE_GEN_MODE=api 时使用，如通义万相/即梦等）
CLOUD_IMAGE_API_KEY=
CLOUD_IMAGE_API_URL=

# CORS 允许来源（前端开发地址）
CORS_ORIGINS=http://localhost:5173
